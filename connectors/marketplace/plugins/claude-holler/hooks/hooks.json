{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holler",
            "args": ["hook", "--harness", "claude"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holler",
            "args": ["monitor", "--harness", "claude"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holler",
            "args": ["monitor", "--harness", "claude"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holler",
            "args": ["monitor", "--harness", "claude"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/holler",
            "args": ["session-end", "--harness", "claude"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
